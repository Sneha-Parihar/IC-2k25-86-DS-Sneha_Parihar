#include <iostream>
//Pre processor directive that tells the compiler to include the standard input/output stream library before compiling the code.
using namespace std;
void Radix_sort(int a[],int size){
    // we take bucket size 10 because decimal numbers contain 10 possible digits (0–9).
        int bucket[10],m,pos,b[size];
        m=a[0];
        for(int i=0;i<size;i++){
                 if(a[i]>m){
                    m=a[i];
                 }
        }
        for(int pos=1;m/pos>0;pos=pos*10){
            for(int i=0;i<10;i++){
                bucket[i]=0;
            }
            for(int i=0;i<size;i++){
                bucket[(a[i]/pos)%10]++;
            }
            for(int i=1;i<10;i++){
                bucket[i]=bucket[i]+bucket[i-1];
            }
            for(int i=size-1;i>=0;i--){
                b[--bucket[(a[i]/pos)%10]]=a[i];
            }
            for(int i=0;i<size;i++){
                a[i]=b[i];
            }
        }
}
int main(){
    int a[7]={8,19,12,1,13,6,22};
     Radix_sort(a,7);
     for(int i=0;i<7;i++){
               cout<<a[i]<<" ";
            }
    return 0;
}
