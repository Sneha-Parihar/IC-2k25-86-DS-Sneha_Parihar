
#include <iostream>
using namespace std;

void Insertion_Sort(int a[], int n) {
    for (int i = 1; i < n; i++) {
        int key = a[i];
        int j = i - 1;

        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = key;
    }
}

int main() {
    int a[6] = {8, 19, 12, 1, 13, 62};

    Insertion_Sort(a, 6);

    for (int i = 0; i < 6; i++) {
        cout << a[i] << " ";
    }

    return 0;
}
