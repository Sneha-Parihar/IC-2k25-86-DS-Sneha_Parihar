void ll::insert(int pos,int val){
    node *nn=new node();
    node *temp;
    int i;
    nn->d=val;
    nn->link=NULL;
    if(pos==1||start==NULL){
        nn->link=start;
        start=nn;

    }
    else{
        i=1;
        temp=start;
        while(i<(pos-1) && temp->link!=NULL){
            temp=temp->link;
            i++;
        }
        nn->link=temp->link;
        temp->link=nn;
    }
}
