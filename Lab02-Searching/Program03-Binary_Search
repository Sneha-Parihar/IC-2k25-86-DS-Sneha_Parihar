#include <iostream>
using namespace std;
int binary_search(int a[],int key,int size){
        int start=0;
        int end=size-1;
        int mid=start+(end-start)/2;
        while (start<=end){
                if(a[mid]<key)
                    start=mid+1;
                else if(a[mid]>key)
                    end=mid-1;
                else
                   return mid;
                mid=start+(end-start)/2;
        }
        return -1;
}
int main(){
    int a[7]={2,3,12,24,32,45};
    int result=binary_search(a,12,7);
    cout<<"Element found at index: "<<result<<endl;
    return 0;
}
